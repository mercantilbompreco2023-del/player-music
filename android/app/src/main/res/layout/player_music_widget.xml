<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#E91C1D2A">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PLAYER MUSIC"
        android:textColor="#B99AFF"
        android:textSize="10sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Player Music"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Abra o aplicativo para tocar"
        android:textColor="#C8C8D2"
        android:textSize="12sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Música anterior"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF" />
        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="56dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Tocar ou pausar"
            android:src="@android:drawable/ic_media_play"
            android:tint="#B99AFF" />
        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Próxima música"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>